    {
      "parameters": {
        "jsCode": "// Contrôle et nettoyage : le formulaire public n'impose pas les champs requis côté serveur.\nconst rows = ($json.body && $json.body.data && $json.body.data.rows) || [];\nconst store = $getWorkflowStaticData('global');\nconst now = Date.now();\nstore.sent = (store.sent || []).filter(t => now - t < 3600 * 1000);\nconst LIMITE_HEURE = 30;\nconst out = [];\nfor (const r of rows) {\n  const email = String(r.Email || '').trim().toLowerCase();\n  const emailOk = /^[^\\s@]+@[^\\s@]+\\.[a-z]{2,}$/.test(email) && email.length <= 120\n    && !/\\.(example|test|invalid|localhost)$/.test(email);\n  // Prénom : lettres, espace, tiret, apostrophe ; 3 mots et 40 caractères au plus (pas de lien ni de phrase)\n  let prenom = String(r.Prenom || '')\n    .replace(/<[^>]*>/g, ' ')\n    .replace(/(https?:\\/\\/|www\\.)\\S*/gi, ' ')\n    .replace(/[^\\p{L}' -]/gu, ' ')\n    .replace(/\\s+/g, ' ')\n    .trim()\n    .split(' ').slice(0, 3).join(' ')\n    .slice(0, 40)\n    .trim();\n  if (!prenom) prenom = 'à toi';\n  const m = /^(\\d{4})-(\\d{2})-(\\d{2})/.exec(String(r.DateMasterclass || ''));\n  const dateFr = m ? `${m[3]}/${m[2]}/${m[1]}` : '';\n  let motif = '';\n  if (!emailOk) motif = 'email invalide';\n  else if (!dateFr) motif = 'date absente';\n  else if (store.sent.length >= LIMITE_HEURE) motif = 'limite horaire atteinte';\n  if (!motif) store.sent.push(now);\n  out.push({ json: { Id: r.Id, email, prenom, dateFr, envoyer: !motif, motif } });\n}\nreturn out;\n"
      },
