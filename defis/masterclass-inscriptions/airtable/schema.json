{
  "$schema": "https://airtable.com/developers/web/api/model/table-model",
  "description": "Schema Airtable prêt à importer via POST /v0/meta/bases/{baseId}/tables pour le défi masterclass-inscriptions (envoi email de confirmation automatique), origine Alegria Eva PRO défi n°3 semaine 38.",
  "base": {
    "name": "Masterclass Inscriptions"
  },
  "tables": [
    {
      "name": "AZ_Inscrits",
      "description": "Inscrits à une masterclass : prénom + email + date de la session. Envoi d'email de confirmation automatique via automation.",
      "fields": [
        {
          "name": "Nom complet",
          "type": "formula",
          "options": {
            "formula": "{Prenom}"
          }
        },
        {
          "name": "Prenom",
          "type": "singleLineText"
        },
        {
          "name": "Email",
          "type": "email"
        },
        {
          "name": "DateMasterclass",
          "type": "date",
          "options": {
            "dateFormat": { "name": "iso" }
          }
        },
        {
          "name": "StatutEmail",
          "type": "singleSelect",
          "options": {
            "choices": [
              { "name": "En attente", "color": "grayLight2" },
              { "name": "Envoyé", "color": "greenLight2" },
              { "name": "Erreur", "color": "redLight2" }
            ]
          }
        },
        {
          "name": "DateInscription",
          "type": "createdTime",
          "options": {
            "dateFormat": { "name": "iso" }
          }
        },
        {
          "name": "Notes",
          "type": "multilineText"
        }
      ]
    }
  ],
  "views": [
    {
      "tableName": "AZ_Inscrits",
      "name": "Tous les inscrits",
      "type": "grid",
      "sort": [{ "field": "DateInscription", "direction": "desc" }]
    },
    {
      "tableName": "AZ_Inscrits",
      "name": "Par masterclass",
      "type": "grid",
      "groupBy": [{ "field": "DateMasterclass", "direction": "asc" }],
      "sort": [{ "field": "Prenom", "direction": "asc" }]
    },
    {
      "tableName": "AZ_Inscrits",
      "name": "Erreurs d'envoi",
      "type": "grid",
      "filter": {
        "conjunction": "and",
        "conditions": [
          { "field": "StatutEmail", "operator": "is", "value": "Erreur" }
        ]
      }
    }
  ],
  "automations": [
    {
      "name": "Envoi email de confirmation",
      "trigger": {
        "type": "recordCreated",
        "tableName": "AZ_Inscrits"
      },
      "actions": [
        {
          "type": "sendEmail",
          "to": "{{trigger.record.Email}}",
          "subject": "Ta place pour la masterclass du {{trigger.record.DateMasterclass}} est confirmée",
          "body": "Salut {{trigger.record.Prenom}},\n\nTa place pour la masterclass du {{trigger.record.DateMasterclass}} est confirmée.\n\nJe t'envoie le lien de connexion + le programme détaillé quelques jours avant.\n\nSi tu as la moindre question d'ici là, réponds simplement à cet email.\n\nÀ très vite,\nDavid"
        },
        {
          "type": "updateRecord",
          "tableName": "AZ_Inscrits",
          "recordId": "{{trigger.record.id}}",
          "fields": {
            "StatutEmail": "Envoyé"
          }
        }
      ]
    }
  ]
}
